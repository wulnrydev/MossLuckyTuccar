<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================= -->
    <!-- MossLuckyTuccar - Şanslı Tüccar Eklentisi                     -->
    <!-- Yapımcı: wulnrydev                                            -->
    <!-- ============================================================= -->
    <groupId>dev.wulnrydev</groupId>
    <artifactId>MossLuckyTuccar</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <!-- Modern Java 17 standardı kullanılıyor -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- PaperMC API deposu -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- ShopGUI+ API deposu (BG-Software) -->
        <repository>
            <id>bg-software</id>
            <url>https://nexus.bg-software.com/repository/api/</url>
        </repository>
        <!-- Vault API için JitPack deposu -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API (Spigot uyumlu) - sunucu tarafından sağlanır -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.20.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- ShopGUI+ API - fiyat bilgisini çekmek için.
             NOT: Bu sürüm (1.113.0) genel depodan inmeyebilir; jar projeye dahildir
             (lib/ShopGUIPlus-1.113.0.jar). Yerel Maven deposuna kurmak için bir kez
             "install-libs.bat" (Windows) veya "install-libs.sh" çalıştırın. -->
        <dependency>
            <groupId>net.brcdev</groupId>
            <artifactId>shopgui</artifactId>
            <version>1.113.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Vault API - ekonomi (dinar) işlemleri için -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Çıktı jar dosyasının adı -->
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <!-- Shade plugin: gerekirse bağımlılıkları paketler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <!-- plugin.yml ve config dosyalarındaki değişkenleri işle -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
